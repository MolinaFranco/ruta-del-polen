---
import Base from '../layouts/Base.astro';
import ButterflyArt from '../components/ButterflyArt.astro';
import { url } from '../utils/url';
---

<Base title="Página no encontrada" description="Esta página no existe. Volvé al inicio de La ruta del polen.">
  <section class="not-found container">
    <div class="not-found__art"><ButterflyArt id="limonera-grande" uid="404" /></div>
    <h1>Esta mariposa se voló</h1>
    <p class="lead">La página que buscás no existe o cambió de lugar.</p>
    <a class="button" href={url('/')}>Volver al inicio</a>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vh, 9rem);
    text-align: center;
  }

  .not-found__art {
    width: min(60%, 16rem);
    rotate: -12deg;
  }

  .not-found h1 {
    font-size: clamp(2.4rem, 1.5rem + 4vw, 5rem);
    color: var(--green-900);
  }
</style>
