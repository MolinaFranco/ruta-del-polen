---
import { PLANT_VIEW_BOX, groundMarkup, potMarkup } from '../art/plantScene';
import { drawPlant } from '../art/plantArt';

interface Props {
  id: string;
  label?: string;
  class?: string;
  // 'both' dibuja tierra y maceta; el contenedor elige cuál mostrar con data-mode.
  base?: 'ground' | 'both';
}

const { id, label, class: className, base = 'ground' } = Astro.props;
const drawing = drawPlant(id);
---

<svg
  class:list={['plant-art', className]}
  viewBox={PLANT_VIEW_BOX}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g class="plant-art__ground" set:html={groundMarkup} />
  {base === 'both' && <g class="plant-art__pot" set:html={potMarkup} />}
  <g class="plant-art__plant" set:html={drawing} />
</svg>

<style>
  .plant-art {
    overflow: visible;
  }

  .plant-art__pot {
    display: none;
  }

  :global([data-mode='balcony']) .plant-art__pot {
    display: inline;
  }

  :global([data-mode='balcony']) .plant-art__ground {
    display: none;
  }

  :global([data-mode='balcony']) .plant-art__plant {
    transform: translateY(-15px);
  }
</style>
