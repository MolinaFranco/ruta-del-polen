---
import { drawPlant } from '../art/plantArt';

interface Props {
  id: string;
  label?: string;
  class?: string;
  // 'both' dibuja tierra y maceta; el contenedor elige cuál mostrar con data-mode.
  base?: 'ground' | 'both';
}

const { id, label, class: className, base = 'ground' } = Astro.props;
const drawing = drawPlant(id);
---

<svg
  class:list={['plant-art', className]}
  viewBox="0 0 200 240"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g class="plant-art__ground">
    <ellipse cx="100" cy="219" rx="84" ry="13" fill="#2c5e33"></ellipse>
    <ellipse cx="100" cy="216" rx="70" ry="8" fill="#4f8a3c"></ellipse>
  </g>
  {
    base === 'both' && (
      <g class="plant-art__pot">
        <path d="M58,206 L142,206 L134,240 L66,240 Z" fill="#c8683c" />
        <path d="M100,206 L142,206 L134,240 L100,240 Z" fill="#b1562e" />
        <rect x="52" y="198" width="96" height="12" rx="4" fill="#d97b4c" />
        <ellipse cx="100" cy="199" rx="44" ry="4" fill="#5a3a24" />
      </g>
    )
  }
  <g class="plant-art__plant" set:html={drawing} />
</svg>

<style>
  .plant-art {
    overflow: visible;
  }

  .plant-art__pot {
    display: none;
  }

  :global([data-mode='balcony']) .plant-art__pot {
    display: inline;
  }

  :global([data-mode='balcony']) .plant-art__ground {
    display: none;
  }

  :global([data-mode='balcony']) .plant-art__plant {
    transform: translateY(-15px);
  }
</style>
