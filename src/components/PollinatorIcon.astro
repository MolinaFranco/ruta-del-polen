---
import { POLLINATOR_VIEW_BOX, pollinatorIcons } from '../art/pollinatorIcons';
import type { PollinatorId } from '../data/pollinators';

interface Props {
  id: PollinatorId;
}

const { id } = Astro.props;
---

<svg class="pollinator-icon" viewBox={POLLINATOR_VIEW_BOX} aria-hidden="true" set:html={pollinatorIcons[id]} />

<style>
  .pollinator-icon {
    width: 100%;
    height: auto;
  }
</style>
