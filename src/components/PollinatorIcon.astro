---
import type { PollinatorId } from '../data/pollinators';

interface Props {
  id: PollinatorId;
}

const { id } = Astro.props;
---

<svg class="pollinator-icon" viewBox="0 0 48 48" aria-hidden="true">
  {
    id === 'hummingbirds' && (
      <g>
        <path d="M30,20 L46,14" stroke="#2b2118" stroke-width="1.8" stroke-linecap="round" />
        <path d="M8,40 C12,30 18,22 26,18 C30,16 33,18 32,22 C30,32 20,36 8,40 Z" fill="#2c8a6a" />
        <path d="M8,40 C16,36 26,30 32,22 C30,32 20,36 8,40 Z" fill="#1f6a50" />
        <path d="M24,22 C18,10 10,6 4,6 C8,14 14,22 22,26 Z" fill="#7fb04f" />
        <circle cx="28" cy="20" r="4.6" fill="#2c8a6a" />
        <path d="M25,23 C27,25 30,25 32,23 L30,27 Z" fill="#d8322a" />
        <circle cx="29.5" cy="19" r="1.1" fill="#2b2118" />
      </g>
    )
  }
  {
    id === 'butterflies' && (
      <g>
        <path d="M24,22 C28,6 46,6 44,18 C43,26 32,28 24,25 Z" fill="#f28c28" />
        <path d="M24,22 C20,6 2,6 4,18 C5,26 16,28 24,25 Z" fill="#f28c28" />
        <path d="M24,25 C30,25 40,30 37,38 C34,43 26,38 24,29 Z" fill="#d9601a" />
        <path d="M24,25 C18,25 8,30 11,38 C14,43 22,38 24,29 Z" fill="#d9601a" />
        <ellipse cx="24" cy="25" rx="1.8" ry="10" fill="#2b2118" />
      </g>
    )
  }
  {
    id === 'bees' && (
      <g>
        <ellipse cx="18" cy="16" rx="9" ry="5.5" fill="#dff0f2" transform="rotate(-28 18 16)" />
        <ellipse cx="31" cy="15" rx="9" ry="5.5" fill="#c9e4e8" transform="rotate(24 31 15)" />
        <ellipse cx="24" cy="29" rx="13" ry="9" fill="#f6c435" />
        <path d="M19,20.8 L19,37.2 M25,20 L25,38 M31,21.4 L31,36.6" stroke="#2b2118" stroke-width="3" />
        <circle cx="12.5" cy="27" r="1.3" fill="#2b2118" />
      </g>
    )
  }
  {
    id === 'bumblebees' && (
      <g>
        <ellipse cx="17" cy="14" rx="8" ry="5" fill="#dff0f2" transform="rotate(-28 17 14)" />
        <ellipse cx="32" cy="13" rx="8" ry="5" fill="#c9e4e8" transform="rotate(24 32 13)" />
        <ellipse cx="24" cy="29" rx="15" ry="12" fill="#2b2118" />
        <path d="M13,22 C18,18 30,18 35,22 L36,27 C30,23 18,23 12,27 Z" fill="#f6c435" />
        <path d="M13,36 C19,40 29,40 35,36 L33,39.5 C28,42 20,42 15,39.5 Z" fill="#f28c28" />
        <circle cx="11.5" cy="30" r="1.3" fill="#fff6dc" />
      </g>
    )
  }
  {
    id === 'others' && (
      <g>
        <path d="M24,8 L24,14 M20,9 L23,14 M28,9 L25,14" stroke="#2b2118" stroke-width="1.6" stroke-linecap="round" />
        <circle cx="24" cy="16" r="5" fill="#2b2118" />
        <ellipse cx="24" cy="30" rx="12" ry="13" fill="#d8322a" />
        <path d="M24,17 L24,43" stroke="#2b2118" stroke-width="1.8" />
        <circle cx="18" cy="26" r="2.4" fill="#2b2118" /><circle cx="30" cy="26" r="2.4" fill="#2b2118" />
        <circle cx="19" cy="35" r="2" fill="#2b2118" /><circle cx="29" cy="35" r="2" fill="#2b2118" />
      </g>
    )
  }
</svg>

<style>
  .pollinator-icon {
    width: 100%;
    height: auto;
  }
</style>
