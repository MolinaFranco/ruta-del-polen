---
import { BUTTERFLY_VIEW_BOX, butterflyMarkup } from '../art/butterflyScene';

interface Props {
  id: string;
  // Sufijo para que los ids internos del SVG no se repitan si la misma mariposa aparece dos veces.
  uid?: string;
  label?: string;
  class?: string;
}

const { id, uid = 'a', label, class: className } = Astro.props;
---

<svg
  class:list={['butterfly', className]}
  viewBox={BUTTERFLY_VIEW_BOX}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={butterflyMarkup(id, `${id}-${uid}`)}
/>

<style>
  .butterfly {
    overflow: visible;
  }
</style>
