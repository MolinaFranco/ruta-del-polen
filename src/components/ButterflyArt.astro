---
import { butterflyArt, foreVeins, hindVeins } from '../art/butterflyArt';

interface Props {
  id: string;
  // Sufijo para que los ids internos del SVG no se repitan si la misma mariposa aparece dos veces.
  uid?: string;
  label?: string;
  class?: string;
}

const { id, uid = 'a', label, class: className } = Astro.props;
const art = butterflyArt[id];
const key = `${id}-${uid}`;
---

<svg
  class:list={['butterfly', className]}
  viewBox="-118 -88 236 172"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <clipPath id={`fore-${key}`}><path d={art.shape.fore}></path></clipPath>
    <clipPath id={`hind-${key}`}><path d={art.shape.hind}></path></clipPath>
    <g id={`wings-${key}`}>
      <g clip-path={`url(#hind-${key})`}>
        <path d={art.shape.hind} fill={art.hind}></path>
        <path d={hindVeins} stroke={art.veins} stroke-width={art.veinWidth} fill="none"></path>
        <g set:html={art.hindPattern} />
        <path d={art.shape.hind} fill="none" stroke={art.margin} stroke-width={art.marginWidth * 2}></path>
      </g>
      <g clip-path={`url(#fore-${key})`}>
        <path d={art.shape.fore} fill={art.fore}></path>
        <path d={foreVeins} stroke={art.veins} stroke-width={art.veinWidth} fill="none"></path>
        <g set:html={art.forePattern} />
        <path d={art.shape.fore} fill="none" stroke={art.margin} stroke-width={art.marginWidth * 2}></path>
      </g>
    </g>
  </defs>

  <g class="butterfly__wing butterfly__wing--right"><use href={`#wings-${key}`}></use></g>
  <g class="butterfly__wing butterfly__wing--left"><use href={`#wings-${key}`} transform="scale(-1 1)"></use></g>

  <g fill={art.body}>
    <path d="M-1,-19 C-6,-36 -14,-46 -21,-52 M1,-19 C6,-36 14,-46 21,-52" fill="none" stroke={art.body} stroke-width="1.4" stroke-linecap="round"></path>
    <circle cx="-21" cy="-52" r="2"></circle>
    <circle cx="21" cy="-52" r="2"></circle>
    <ellipse cx="0" cy="20" rx="3.4" ry="19"></ellipse>
    <ellipse cx="0" cy="-4" rx="4.6" ry="10"></ellipse>
    <circle cx="0" cy="-16" r="4.2"></circle>
  </g>
</svg>

<style>
  .butterfly {
    overflow: visible;
  }

  /* El aleteo se maneja con la variable --flap (0 = alas abiertas, 1 = casi cerradas). */
  .butterfly__wing {
    transform-box: view-box;
    transform-origin: 50% 50%;
    transform: scaleX(calc(1 - var(--flap, 0) * 0.8));
  }
</style>
